# Copiar a .env y ajustar. Todas las variables usan el prefijo TABLERO_.

# SQLite en la v1. Para PostgreSQL:
# TABLERO_DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/tablero
TABLERO_DATABASE_URL=sqlite:///./tablero.db

# Divisa base por defecto al crear un portafolio (ISO 4217).
TABLERO_DEFAULT_BASE_CURRENCY=COP

# Zona horaria de presentación. El almacenamiento es SIEMPRE UTC.
TABLERO_DISPLAY_TIMEZONE=America/Bogota

# Volcar el SQL emitido por SQLAlchemy (ruidoso, solo para depurar).
TABLERO_SQL_ECHO=false

TABLERO_LOG_LEVEL=INFO
